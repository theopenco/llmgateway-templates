{
  "name": "@llmgateway/cli",
  "version": "0.0.0",
  "description": "CLI tool for scaffolding LLM Gateway templates and managing AI projects",
  "type": "module",
  "bin": {
    "llmgateway": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "llm",
    "ai",
    "cli",
    "template",
    "scaffold",
    "llmgateway"
  ],
  "author": "LLM Gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theopenco/llmgateway-templates.git",
    "directory": "packages/llmgateway-cli"
  },
  "dependencies": {
    "@llmgateway/models": "^1.291.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "degit": "^2.8.6",
    "fs-extra": "^11.4.0",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/degit": "^2.8.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.5",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
