# Get your API key from https://llmgateway.io
LLMGATEWAY_API_KEY=your_api_key_here

# Optional: Discord webhook URL for posting summaries
# Create a webhook in your Discord channel settings
DISCORD_WEBHOOK_URL=

# Optional: your enterprise inference gateway (without /v1)
# LLMGATEWAY_GATEWAY_URL=https://gateway.example.com

# Optional: override the example model with an allowed gateway model
# LLMGATEWAY_MODEL=gpt-5.4-mini
