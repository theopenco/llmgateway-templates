{
  "name": "@llmgateway-templates/slack-qa-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/lib/local.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env.local dist/lib/local.js",
    "test": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.41.1",
    "@chat-adapter/state-redis": "^4.41.1",
    "@llmgateway/ai-sdk-provider": "^4.1.0",
    "ai": "^7.0.139",
    "chat": "^4.41.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
